{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kervan",
  "version": "0.1.0",
  "identifier": "com.kdrgny.kervan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kervan",
        "width": 1152,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#14121c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Kahraman kafileni büyüt, dalgalara dayan.",
    "copyright": "© 2026 Kadir Günay"
  }
}
